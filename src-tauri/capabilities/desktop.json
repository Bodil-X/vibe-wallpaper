{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-specific capabilities for file system access",
  "windows": ["main", "preview"],
  "permissions": [
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-write-file",
    "fs:allow-create",
    {
      "identifier": "fs:scope",
      "allow": [
        "$TEMP/unsplash_wallpaper/*",
        "$APPDATA/unsplash-wallpaper/*",
        "$HOME/Pictures/*"
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}